---
/** A note beside the prose: a card with an accent bar down its left, an icon, a title. */
interface Props {
  type?: "info" | "warn" | "tip";
  title?: string;
}
const { type = "info", title } = Astro.props;
const bar = { info: "before:bg-brand", warn: "before:bg-marker", tip: "before:bg-emerald-500" }[type];
const tint = { info: "text-brand", warn: "text-marker", tip: "text-emerald-500" }[type];
---

<div
  class:list={[
    "bg-card relative my-6 flex gap-3 rounded-lg border p-4 ps-6 text-sm before:absolute before:top-3 before:bottom-3 before:left-2.5 before:w-0.5 before:rounded-full",
    bar,
  ]}
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class:list={["mt-0.5 size-4 shrink-0", tint]} aria-hidden="true">
    {
      type === "warn" ? (
        <>
          <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
          <path d="M12 9v4M12 17h.01" />
        </>
      ) : type === "tip" ? (
        <>
          <path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5" />
          <path d="M9 18h6M10 22h4" />
        </>
      ) : (
        <>
          <circle cx="12" cy="12" r="10" />
          <path d="M12 16v-4M12 8h.01" />
        </>
      )
    }
  </svg>
  <div class="min-w-0 flex-1">
    {title && <p class="text-foreground mt-0 mb-1 font-medium">{title}</p>}
    <div class="text-foreground/80 [&>p]:my-1 [&>p:first-child]:mt-0 [&>p:last-child]:mb-0"><slot /></div>
  </div>
</div>
