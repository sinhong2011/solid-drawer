---
/**
 * The mark: two sheets stacked on an app tile - the back one scaled back the
 * way a nested drawer draws it - the front one carrying a handle.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const id = `logo-${Math.random().toString(36).slice(2, 8)}`;
---

<svg viewBox="0 0 32 32" class={className} aria-hidden="true">
  <defs>
    <linearGradient id={`${id}-tile`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#3d6bff"></stop>
      <stop offset="1" stop-color="#1436c9"></stop>
    </linearGradient>
    <clipPath id={`${id}-clip`}><rect width="32" height="32" rx="8"></rect></clipPath>
  </defs>
  <rect width="32" height="32" rx="8" fill={`url(#${id}-tile)`}></rect>
  <g clip-path={`url(#${id}-clip)`}>
    <rect x="7" y="12" width="18" height="24" rx="5" fill="#fff" opacity="0.38"></rect>
    <rect x="4" y="16.5" width="24" height="22" rx="6" fill="#fff"></rect>
    <rect x="13" y="20" width="6" height="2" rx="1" fill="#1436c9" opacity="0.55"></rect>
  </g>
</svg>
